{
  "name": "@proticom/paperboy-widget",
  "version": "0.2.2",
  "description": "Embeddable web/markdown toggle widget — converts any page to Markdown with one click.",
  "homepage": "https://github.com/proticom/paperboy/tree/main/paperboy-widget#readme",
  "main": "dist/paperboy-widget.min.js",
  "type": "commonjs",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.js",
    "build:watch": "node build.js --watch",
    "prepublishOnly": "npm run build",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "markdown",
    "widget",
    "paperboy",
    "html-to-markdown",
    "turndown",
    "embeddable"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/proticom/paperboy.git",
    "directory": "paperboy-widget"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@proticom/paperboy-converter": "*"
  },
  "devDependencies": {
    "esbuild": "^0.27.4",
    "jsdom": "^25.0.0",
    "vitest": "^3.2.4"
  }
}
