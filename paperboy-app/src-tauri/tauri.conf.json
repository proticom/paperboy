{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paperboy",
  "version": "0.2.2",
  "identifier": "run.paperboy.editor",
  "build": {
    "beforeDevCommand": "node scripts/dev-server.mjs",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Paperboy",
        "width": 1200,
        "height": 800,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 12,
          "y": 17
        }
      }
    ]
  },
  "bundle": {
    "active": true,
    "category": "Office",
    "copyright": "Copyright (c) 2026 Proticom",
    "shortDescription": "Convert the web into newspaper-print markdown.",
    "longDescription": "Paperboy is a desktop markdown editor that converts web pages, PDFs, DOCX, EPUB, and images into clean, newspaper-style markdown. It ships as a Tauri 2 app for macOS, Windows, and Linux, with a side-by-side source/preview editor and one-click export to PDF, HTML, and DOCX.",
    "publisher": "Proticom <maintainers@paperboy.run>",
    "homepage": "https://paperboy.run",
    "license": "MIT",
    "targets": ["dmg", "nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd", "mdx"],
        "name": "Markdown",
        "description": "Markdown document",
        "role": "Editor",
        "rank": "Default",
        "mimeType": "text/markdown"
      },
      {
        "ext": ["txt"],
        "name": "Plain Text",
        "description": "Plain text document",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "text/plain"
      },
      {
        "ext": ["html", "htm"],
        "name": "HTML",
        "description": "HTML document",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "text/html"
      },
      {
        "ext": ["rtf"],
        "name": "Rich Text",
        "description": "Rich Text Format document",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "application/rtf"
      },
      {
        "ext": ["docx"],
        "name": "Word Document",
        "description": "Microsoft Word document",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      },
      {
        "ext": ["pdf"],
        "name": "PDF",
        "description": "PDF document",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "application/pdf"
      },
      {
        "ext": ["epub"],
        "name": "EPUB",
        "description": "EPUB book",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "application/epub+zip"
      },
      {
        "ext": ["csv"],
        "name": "CSV",
        "description": "Comma-separated values",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "text/csv"
      },
      {
        "ext": ["xlsx"],
        "name": "Excel Spreadsheet",
        "description": "Microsoft Excel spreadsheet",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
      },
      {
        "ext": ["png", "jpg", "jpeg", "gif", "bmp", "webp", "tif", "tiff"],
        "name": "Image",
        "description": "Image file",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "image/*"
      }
    ],
    "macOS": {
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "10.13",
      "frameworks": [],
      "exceptionDomain": null
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1 | libappindicator3-1",
          "librsvg2-2",
          "libsoup-3.0-0"
        ],
        "section": "text",
        "priority": "optional"
      },
      "appimage": {
        "bundleMediaFramework": true,
        "files": {}
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libappindicator-gtk3",
          "librsvg2",
          "libsoup3"
        ],
        "epoch": 0,
        "release": "1"
      }
    }
  }
}
