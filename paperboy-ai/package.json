{
  "name": "@proticom/paperboy-ai",
  "version": "0.2.2",
  "description": "Shared AI provider catalog and image-description helpers for Paperboy (OpenRouter, OpenAI, Anthropic, xAI, Ollama, local endpoints).",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/proticom/paperboy/tree/main/paperboy-ai#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/proticom/paperboy.git",
    "directory": "paperboy-ai"
  },
  "keywords": [
    "paperboy",
    "ai",
    "openrouter",
    "openai",
    "anthropic",
    "ollama",
    "vision",
    "markdown"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@proticom/paperboy-converter": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^24.6.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
