{
  "name": "@proticom/paperboy-cli",
  "version": "0.3.0",
  "description": "Command-line edition of Paperboy: convert files and crawl entire sites to clean Markdown — offline, deterministic, scriptable (PDF, DOCX, EPUB, HTML, OCR, and more).",
  "license": "MIT",
  "homepage": "https://github.com/proticom/paperboy/tree/main/paperboy-cli#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/proticom/paperboy.git",
    "directory": "paperboy-cli"
  },
  "keywords": [
    "markdown",
    "cli",
    "command-line",
    "converter",
    "crawl",
    "crawler",
    "sitemap",
    "pdf",
    "docx",
    "epub",
    "html",
    "ocr",
    "paperboy"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "paperboy": "./dist/cli.js",
    "paperboy-cli": "./dist/cli.js",
    "paperboy-dispatch": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./converter": "./dist/converter.js",
    "./config": "./dist/config.js",
    "./setup": "./dist/setup.js",
    "./doctor": "./dist/doctor.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-lang-data.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "doctor": "node ./dist/cli.js doctor",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "test:coverage": "npm run build && vitest run --coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@proticom/paperboy-converter": "*",
    "@inquirer/prompts": "^7.8.4",
    "commander": "^14.0.1"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@types/node": "^24.6.1",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
